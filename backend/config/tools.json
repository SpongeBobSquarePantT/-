    {
      "id": "jdk8",
      "name": "OpenJDK 8 (Temurin)",
      "category": "java",
      "description": "Java 8 LTS 运行时与编译工具链",
      "windows": {
        "type": "winget",
        "package": "EclipseAdoptium.Temurin.8.JDK",
        "check": "java -version 2>&1 | findstr /R \"1\\.8\"",
        "paths": [
          "%ProgramFiles%\\Java\\jdk1.8*\\bin\\java.exe",
          "%ProgramFiles%\\Eclipse Adoptium\\jdk-8*\\bin\\java.exe",
          "%USERPROFILE%\\.jdks\\*\\jdk1.8*\\bin\\java.exe",
          "%USERPROFILE%\\.jdks\\corretto-8*\\bin\\java.exe",
          "%USERPROFILE%\\.jdks\\temurin-8*\\bin\\java.exe",
          "%USERPROFILE%\\.jdks\\ms-8*\\bin\\java.exe"
        ],
        "registry": [
          "Temurin 8",
          "AdoptOpenJDK 8",
          "OpenJDK 8"
        ],
        "java_version": "8",
        "executables": []
      },
      "linux": {
        "apt": "openjdk-8-jdk",
        "dnf": "java-1.8.0-openjdk-devel",
        "pacman": "jdk8-openjdk",
        "check": "java -version 2>&1 | grep -E '1\\.8'"
      }
    },
